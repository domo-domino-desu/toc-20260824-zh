# Graph to start layout of a machine minimization problem
# Run with: dot -Tpdf minimize.dot -o minimize.pdf

digraph G{	node [shape = doublecircle]; q1, q3;
	node [shape = circle] q0 q2 q4 q5;
  q0 -> q1 [label="a"];
  q0 -> q3 [label="b"];
  q1 -> q2 [label="a"];
  q1 -> q5 [label="b"];
  q2 -> q1 [label="a"];
  q2 -> q3 [label="b"];
  q3 -> q5 [label="a"];
  q3 -> q4 [label="b"];
  q4 -> q1 [label="a"];
  q4 -> q3 [label="b"];
  q5 -> q5 [label="a,b"];
}