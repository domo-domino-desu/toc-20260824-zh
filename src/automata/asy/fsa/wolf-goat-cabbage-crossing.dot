# Graph to start layout of wolf-goat-cabbage river crossing problem
# Run with: dot -Tpdf wolf-goat-cabbage-crossing.dot -o wgc.pdf

digraph G{	node [shape = doublecircle]; q9;
	node [shape = circle] q0 q1 q2 q3 q4 q5 q6 q7 q8 e;
  q0 -> q5 [label="g"];
  q1 -> q7 [label="w"];
  q1 -> q6 [label="g"];
  q2 -> q8 [label="w"];
  q2 -> q6 [label="c"];
  q2 -> q5 [label="n"];
  q3 -> q8 [label="g"];
  q3 -> q7 [label="c"];
  q4 -> q9 [label="g"];
  q4 -> q7 [label="n"];
  q5 -> q0 [label="g"];
  q5 -> q2 [label="n"];
  q6 -> q1 [label="g"];
  q6 -> q2 [label="c"];
  q7 -> q1 [label="w"];
  q7 -> q3 [label="c"];
  q7 -> q4 [label="n"];
  q8 -> q2 [label="w"];
  q8 -> q3 [label="g"];
  q8 -> q6 [label="n"];
  q9 -> q9 [ label="w,g,c,n" ];
}