# Graph to start layout of first table minimization example
# Run with: dot -Tpdf min.dot -o min.pdf


digraph G{	node [shape = doublecircle]; q1 q2 q5;
	node [shape = circle] q0 q3 q4;
  q0 -> q1 [ label="a" ];
  q0 -> q2 [ label="b" ];
  q1 -> q3 [ label="a" ];
  q1 -> q4 [ label="b" ];
  q2 -> q4 [ label="a" ];
  q2 -> q3 [ label="b" ];
  q3 -> q5 [ label="a,b" ];
  q4 -> q5 [ label="a,b" ];
  q5 -> q5 [ label="a,b" ];
}