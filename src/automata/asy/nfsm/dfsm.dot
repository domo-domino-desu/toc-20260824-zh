# Graph to start layout of the DFSM from NFSM graph

digraph G{	node [shape = doublecircle]; s1 s3 s4 s5 s6 s7;
	node [shape = circle] s0 s2;
  s0 -> s0 [ label="a,b" ];
  s1 -> s4 [ label="a" ];
  s1 -> s0 [ label="b" ];
  s2 -> s0 [ label="a" ];
  s2 -> s3 [ label="b" ];
  s3 -> s0 [ label="a,b" ];
  s4 -> s4 [ label="a" ];
  s4 -> s3 [ label="b" ];
  s5 -> s4 [ label="a" ];
  s5 -> s0 [ label="b" ];
  s6 -> s0 [ label="a" ];
  s6 -> s3 [ label="b" ];
  s7 -> s4 [ label="a" ];
  s7 -> s3 [ label="b" ];
}