# Graph to start layout of the DFSM from NFSM with epsilon graph
# Call with dot -Tpng dfsm_w_epsilon.dot -o dfsm_w_epsilon.png

digraph G{	node [shape = doublecircle]; s2 s5 s8 s9 s11 s12 s14 s15;
	node [shape = circle] s0 s1 s3 s4 s6 s7 s10 s13;
  s0 -> s0 [ label="a,b" ];
  s1 -> s3 [ label="a" ];
  s1 -> s12 [ label="b" ];
  s2 -> s0 [ label="a,b" ];
  s3 -> s0 [ label="a" ];
  s3 -> s7 [ label="b" ];
  s4 -> s4 [ label="a" ];
  s4 -> s0 [ label="b" ];
  s5 -> s3 [ label="a" ];
  s5 -> s12 [ label="b" ];
  s6 -> s3 [ label="a" ];
  s6 -> s12 [ label="b" ];
  s7 -> s10 [ label="a" ];
  s7 -> s12 [ label="b" ];
  s8 -> s0  [ label="a" ];
  s8 -> s7  [ label="b" ];
  s9 -> s4  [ label="a" ];
  s9 -> s0  [ label="b" ];
  s10 -> s4  [ label="a" ];
  s10 -> s7  [ label="b" ];
  s11 -> s3  [ label="a" ];
  s11 -> s12 [ label="b" ];
  s12 -> s10 [ label="a" ];
  s12 -> s12 [ label="b" ];
  s13 -> s10 [ label="a" ];
  s13 -> s12 [ label="b" ];
  s14 -> s4  [ label="a" ];
  s14 -> s7  [ label="b" ];
  s15 -> s10 [ label="a" ];
  s15 -> s12 [ label="b" ];
}