# Graph to start layout of FSM accepting string where next to last is a
# Run with: dot -Tpdf next-to-last-a.dot -o ntla.pdf

digraph G{	node [shape = doublecircle]; s4 s5 s6 s7;
	node [shape = circle] s0 s1 s2 s3;
  s0 -> s0 [label="a,b"];
  s1 -> s3 [label="a"];
  s1 -> s1 [label="b"];
  s2 -> s4 [label="a,b"];
  s3 -> s7 [label="a"];
  s3 -> s5 [label="b"];
  s4 -> s0 [label="a,b"];
  s5 -> s3 [label="a"];
  s5 -> s1 [label="b"];
  s6 -> s4 [label="a,b"];
  s7 -> s7 [label="a"];
  s7 -> s5 [label="b"];
}