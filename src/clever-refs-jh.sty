% clever-refs-jh.sty
% 2025-May-26 JH LPPL
% For years I used cleveref to get references that, for instance,
% give "Theorem 3.1" instead of just "3.1".  But that package started failing
% with the rewrite of LaTeX for accessibility.  The recommendation is
% to use zref and zref-clever.  I had trouble getting it to go but
% egreg on the TeX SE helped: https://tex.stackexchange.com/a/745011/339
% Now I need to share that answer across a number of files, including
% answers.cls and the slides style presentation.sty.

\usepackage{zref-clever}

\AddToHook{env/lemma/begin}{\zcsetup{countertype={theorem=lemma}}}
\AddToHook{env/corollary/begin}{\zcsetup{countertype={theorem=corollary}}}
\AddToHook{env/definition/begin}{\zcsetup{countertype={theorem=definition}}}
\AddToHook{env/example/begin}{\zcsetup{countertype={theorem=example}}}
\AddToHook{env/remark/begin}{\zcsetup{countertype={theorem=remark}}}
\AddToHook{env/problem/begin}{\zcsetup{countertype={theorem=problem}}}
\AddToHook{env/churchsthesis/begin}{\zcsetup{countertype={theorem=churchsthesis}}}
\AddToHook{env/tablefigure/begin}{\zcsetup{countertype={theorem=tablefigure}}}
\AddToHook{env/animatefigure/begin}{\zcsetup{countertype={theorem=animatefigure}}}
\AddToHook{env/tablefigure/begin}{\zcsetup{countertype={theorem=tablefigure}}}
\AddToHook{env/animatefigure/begin}{\zcsetup{countertype={theorem=animatefigure}}}
\AddToHook{env/tablehere/begin}{\zcsetup{countertype={theorem=tablehere}}}
\AddToHook{env/figurehere/begin}{\zcsetup{countertype={theorem=figurehere}}}
\AddToHook{env/fig/begin}{\zcsetup{countertype={theorem=fig}}}
\AddToHook{env/exercise/begin}{\zcsetup{countertype={theorem=exercise}}}
\AddToHook{env/exerciselist/begin}{\zcsetup{countertype={theorem=exerciselist}}}

\zcRefTypeSetup{theorem}{
  Name-sg = 定理 , name-sg = 定理 , Name-pl = 定理 , name-pl = 定理 ,
}
\zcRefTypeSetup{lemma}{
  Name-sg = 引理 , name-sg = 引理 , Name-pl = 引理 , name-pl = 引理 ,
}
\zcRefTypeSetup{corollary}{
  Name-sg = 推论 , name-sg = 推论 , Name-pl = 推论 , name-pl = 推论 ,
}
\zcRefTypeSetup{definition}{
  Name-sg = 定义 , name-sg = 定义 , Name-pl = 定义 , name-pl = 定义 ,
}
\zcRefTypeSetup{example}{
  Name-sg = 例 , name-sg = 例 , Name-pl = 例 , name-pl = 例 ,
}
\zcRefTypeSetup{remark}{
  Name-sg = 注 , name-sg = 注 , Name-pl = 注 , name-pl = 注 ,
}
\zcRefTypeSetup{problem}{
  Name-sg = 问题 , name-sg = 问题 , Name-pl = 问题 , name-pl = 问题 ,
}
\zcRefTypeSetup{churchsthesis}{
  Name-sg = Church 论题 , name-sg = Church 论题 , Name-pl = Church 论题 , name-pl = Church 论题 ,
}
\zcRefTypeSetup{tablefigure}{
  Name-sg = 表 , name-sg = 表 , Name-pl = 表 , name-pl = 表 ,
}
% Redefine the following if printing to paper?
\zcRefTypeSetup{animatefigure}{
  Name-sg = 动画 , name-sg = 动画 , Name-pl = 动画 , name-pl = 动画 ,
}
\zcRefTypeSetup{tablehere}{
  Name-sg = 表 , name-sg = 表 , Name-pl = 表 , name-pl = 表 ,
}
\zcRefTypeSetup{figurehere}{
  Name-sg = 图 , name-sg = 图 , Name-pl = 图 , name-pl = 图 ,
}
\zcRefTypeSetup{fig}{
  Name-sg = 图 , name-sg = 图 , Name-pl = 图 , name-pl = 图 ,
}
\zcRefTypeSetup{appendix}{
  Name-sg = 附录 , name-sg = 附录 , Name-pl = 附录 , name-pl = 附录 ,
}
\zcRefTypeSetup{extrasection}{
  Name-sg = 补充 , name-sg = 补充 , Name-pl = 补充 , name-pl = 补充 ,
}
\zcRefTypeSetup{exercise}{
  Name-sg = 习题 , name-sg = 习题 , Name-pl = 习题 , name-pl = 习题 ,
