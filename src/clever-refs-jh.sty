\zcRefTypeSetup{exerciselisti}{
  Name-sg = 习题 , name-sg = 习题 , Name-pl = 习题 , name-pl = 习题 ,
}
\zcRefTypeSetup{item}{
  Name-sg = 项 , name-sg = 项 , Name-pl = 项 , name-pl = 项 ,
}
