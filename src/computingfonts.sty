% computingfonts.sty
%  Fonts used.  This is a separate file for use also by Asymptote files.

% 中译本统一使用 LuaLaTeX。ctex 的 Fandol 字体保证本机与 CI 的中文
% 字形一致；原书使用 XCharter/newtxmath，因此西文和数学字体改用配套的
% New Computer Modern。
\RequirePackage[fontset=fandol]{ctex}
\RequirePackage[default]{fontsetup}

% 中文正文强调使用黑体，而不是给宋体机械加粗。
\setCJKfamilyfont{zhemph}{FandolSong-Regular}[
  Extension = .otf,
  BoldFont = FandolHei-Regular,
  ItalicFont = FandolKai-Regular,
  BoldItalicFont = FandolKai-Regular,
]
\let\computingoriginaltextbf\textbf
\renewcommand{\textbf}[1]{%
  \ifmmode
    \computingoriginaltextbf{#1}%
  \else
    {\CJKfamily{zhemph}\bfseries #1}%
  \fi}
\linespread{1.04}

% Give access to double quote inside of syntax environments
\newcommand{\textsinglequote}{{\ttfamily'}}
\newcommand{\textdoublequote}{{\ttfamily"}}
