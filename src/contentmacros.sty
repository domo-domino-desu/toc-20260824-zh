% contentmacros.sty
%  Macros used when writing text for _Computing_.  This is a separate file 
%  for use also by Asymptote files.
\usepackage{mathtools,amssymb}

% cases with square brackets
% Kottwitz 
\newenvironment{sqcases}{%
\matrix@check\sqcases\env@sqcases
}{%
\endarray\right.%
}
\def\env@sqcases{%
\let\@ifnextchar\new@ifnextchar
\left\lbrack
\def\arraystretch{1.2}%
\array{@{}l@{\quad}l@{}}%
}

