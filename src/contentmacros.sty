% Box of length at least xxx
% If natural length is less than that specified, then the specified length
% will get used.  Else, box will grow.
% https://tex.stackexchange.com/a/188364/121234
% (Changed to have a default width of 1em.)
% Use: \minwidthbox[3em]{Hello}
\DeclareRobustCommand{\minwidthbox}[2][1em]{%
  \ifmmode
    \expandafter\mathmakebox
  \else
    \expandafter\makebox
  \fi
  [\ifdim#1<\width\width\else#1\fi]{#2}%
}
% Want nodes to have a minimum width label 
\DeclareRobustCommand{\nodebox}[1]{\minwidthbox[0.15em]{#1}}

