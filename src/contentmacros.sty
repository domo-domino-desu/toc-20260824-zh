% Godel numbers from Sam Buss http://www.logicmatters.net/latex-for-logicians/symbols/corner-quotes-for-godel-numbers/
\newbox\gnBoxA
\newdimen\gnCornerHgt
\setbox\gnBoxA=\hbox{$\ulcorner$}
\global\gnCornerHgt=\ht\gnBoxA
\newdimen\gnArgHgt
\def\godelnum #1{%
  \setbox\gnBoxA=\hbox{$#1$}%
  \gnArgHgt=\ht\gnBoxA%
  \ifnum     \gnArgHgt<\gnCornerHgt \gnArgHgt=0pt%
  \else \advance \gnArgHgt by -\gnCornerHgt%
  \fi \raise\gnArgHgt\hbox{$\ulcorner$} \box\gnBoxA %
  \raise\gnArgHgt\hbox{$\urcorner$}}

% Vertically center graphics
% ex: \vcenteredhbox{\usegraphics{mygraph.png}}
% From http://tex.stackexchange.com/questions/7219/how-to-vertically-center-two-images
\newcommand*{\vcenteredhbox}[1]{\begingroup
\setbox0=\hbox{#1}\parbox{\wd0}{\box0}\endgroup}

% Column of numbers right-flushed  
%  I often want to center headers, then centered below the headers are numbers
% aligned on the right.  This:
% \begin{array}{r|B}
%       \multicolumn{1}{c}{\ }
%       &\multicolumn{1}{c}{y=0}  \\ \cline{2-2}
%    k=1 &1 \\
%    k=2 &2 \\
%    k=3 &12 
% \end{array}
% will give me this:
%      y=0
% k=1   1
% k=2   2
% k=3  12
% There is a different capital letter for each width of the widest column.
% A for a max-one-digit-wide, B for max-two-digit-wide, etc.  
\usepackage{calc}
\newlength{\widthcharsA} \settowidth{\widthcharsA}{$0$}
\newlength{\widthcharsB} \settowidth{\widthcharsB}{$01$}
\newlength{\widthcharsC} \settowidth{\widthcharsC}{$012$}
\newlength{\widthcharsD} \settowidth{\widthcharsD}{$0123$}
\newlength{\widthcharsE} \settowidth{\widthcharsE}{$01234$}
\newlength{\widthcharsF} \settowidth{\widthcharsF}{$012345$}
\newlength{\widthcharsG} \settowidth{\widthcharsG}{$0123456$}
\newlength{\widthcharsH} \settowidth{\widthcharsH}{$01234567$}
\usepackage{array}
\newsavebox{\rightbox}
\newcommand{\rightboxitA}[1]{\makebox[\widthcharsA][r]{#1}}
\newcolumntype{A}{>{\begin{lrbox}{\rightbox}}{c}<{\end{lrbox}\rightboxitA{\unhbox\rightbox}}}
\newcommand{\rightboxitB}[1]{\makebox[\widthcharsB][r]{#1}}
\newcolumntype{B}{>{\begin{lrbox}{\rightbox}}{c}<{\end{lrbox}\rightboxitB{\unhbox\rightbox}}}
\newcommand{\rightboxitC}[1]{\makebox[\widthcharsC][r]{#1}}
\newcolumntype{C}{>{\begin{lrbox}{\rightbox}}{c}<{\end{lrbox}\rightboxitC{\unhbox\rightbox}}}
\newcommand{\rightboxitD}[1]{\makebox[\widthcharsD][r]{#1}}
\newcolumntype{D}{>{\begin{lrbox}{\rightbox}}{c}<{\end{lrbox}\rightboxitD{\unhbox\rightbox}}}
\newcommand{\rightboxitE}[1]{\makebox[\widthcharsE][r]{#1}}
\newcolumntype{E}{>{\begin{lrbox}{\rightbox}}{c}<{\end{lrbox}\rightboxitE{\unhbox\rightbox}}}
\newcommand{\rightboxitF}[1]{\makebox[\widthcharsF][r]{#1}}
\newcolumntype{F}{>{\begin{lrbox}{\rightbox}}{c}<{\end{lrbox}\rightboxitF{\unhbox\rightbox}}}


