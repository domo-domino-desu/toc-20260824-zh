\newcommand{\acceptingstatemark}{\ensuremath{\scriptstyle +}}
\newcommand{\acceptingstate}{\llap{\acceptingstatemark} }

\newenvironment{transitionfunction}[1][\Delta]{%
  \renewcommand{\arraystretch}{1.1}
  \begin{tabular}{r|*{10}{c}}
    \multicolumn{1}{r}{$#1$}
}{%
  \end{tabular}    
}

