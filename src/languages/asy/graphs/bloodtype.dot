# Graph to start layout of blood type compatibility

digraph G {
     ominus -> ominus;
     ominus -> oplus;
     ominus -> aminus;
     ominus -> aplus;
     ominus -> bminus;
     ominus -> bplus;
     ominus -> abminus;
     ominus -> abplus;
     oplus -> aplus;
     oplus -> bplus;
     oplus -> abplus;
     aminus -> aplus;
     aminus -> abminus;
     aminus -> abplus;
     aplus -> abplus;
     bminus -> bplus;
     bminus -> abminus;
     bminus -> abplus;
     bplus -> abplus;
     abminus -> abplus;
}