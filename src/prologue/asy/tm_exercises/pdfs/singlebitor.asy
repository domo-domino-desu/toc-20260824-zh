// pdfs/singlebitor.asy
// Draw a succession of tapes for a Turing machine computation
// This is generated by computing/bin/turing_machine/tm_to_asy.py

import settings;
settings.outformat="pdf";
settings.render=0;

// cd needed for relative import 
cd("../../../../asy");
// import jh;
import tape;
cd("");

unitsize(1pt);

tape_output("singlebitor000","01",0,"$\state{0}$");
tape_output("singlebitor001"," 1",0,"$\state{10}$");
tape_output("singlebitor002"," 1",1,"$\state{11}$");
tape_output("singlebitor003"," 1",1,"$\state{100}$");

