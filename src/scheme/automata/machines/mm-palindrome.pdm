# mm-palindrome.pdm  Pushdown machine to accept palindromes with middle marker
# q0 is pushing g0's for a's, and g1's for b's,
# q1 is popping and checking it matches the token on the tape
# q2 is an error state, q3 is the accepting state
ACCEPTING 3
0 a BOT  0 (g0 BOT)
0 b BOT  0 (g1 BOT)
0 c BOT  1 (BOT)
0 B BOT  3 (BOT)
0 a g0   0 (g0 g0)  # push g0 for an a
0 a g1   0 (g0 g1)  #
0 b g0   0 (g1 g0)   # push g1 for a b
0 b g1   0 (g1 g1)
0 c g0   1 (g0)    # switch to pop mode
0 c g1   1 (g1)    #
0 B g0   2 (g0)  # go to error state
0 B g1   2 (g1)
1 a BOT  2 (BOT)
1 b BOT  2 (BOT)
1 c BOT  2 (BOT)
1 B BOT  3 (BOT)
1 a g0   1 ()    # empty list means pop 
1 a g1   2 (g1)
1 b g0   2 (g0)
1 b g1   1 ()
1 c g0   2 (g0)
1 c g1   2 (g1)
1 B g0   2 (g0)
1 B g1   2 (g1)
