# Graph to start layout of the DFSM from NFSM graph
# Run with $ dot -Tpng dfsm-from-nfsm.dot > dfsm-from-nfsm.png

digraph G{
  node [shape = doublecircle]; s3 s5 s6 s7;
  node [shape = circle] s0 s1 s2 s4;
  s0 -> s0 [ label="0,1" ];
  s1 -> s1 [ label="0" ];
  s1 -> s4 [ label="1" ];
  s2 -> s0 [ label="0" ];
  s2 -> s5 [ label="1" ];
  s3 -> s3 [ label="0" ];
  s3 -> s0 [ label="1" ];
  s4 -> s1 [ label="0" ];
  s4 -> s7 [ label="1" ];
  s5 -> s5 [ label="0" ];
  s5 -> s4 [ label="1" ];
  s6 -> s3 [ label="0" ];
  s6 -> s5 [ label="1" ];
  s7 -> s5 [ label="0" ];
  s7 -> s7 [ label="1" ];
}