# Graph to start layout of the DFSM from NFSM graph
# Run with $ dot -Tpng dfsm-slide.dot > dfsm-slide.png

digraph G{
  node [shape = doublecircle]; s2 s5 s8 s9 s11 s14 s15;
  node [shape = circle] s0 s1 s3 s4 s6 s7 s10 s12 s13;
  s0 -> s0 [ label="0,1" ];
  s1 -> s15 [ label="0" ];
  s1 -> s5 [ label="1" ];
  s2 -> s5 [ label="0" ];q
  s2 -> s2 [ label="1" ];
  s3 -> s12 [ label="0" ];
  s3 -> s14 [ label="1" ];
  s4 -> s12 [ label="0" ];
  s4 -> s2 [ label="1" ];
  s5 -> s15 [ label="0" ];
  s5 -> s5 [ label="1" ];
  s6 -> s15 [ label="0,1" ];
  s7 -> s15 [ label="0" ];
  s7 -> s5 [ label="1" ];
  s8 -> s12 [ label="0" ];
  s8 -> s14 [ label="1" ];
  s9 -> s12 [ label="0" ];
  s9 -> s2 [ label="1" ];
  s10 -> s12 [ label="0" ];
  s10 -> s14 [ label="1" ];
  s11 -> s15 [ label="0,1" ];
  s12 -> s15 [ label="0" ];
  s12 -> s5 [ label="1" ];
  s13 -> s15 [ label="0,1" ];
  s14 -> s12 [ label="0" ];
  s14 -> s14 [ label="1" ];
  s15 -> s15 [ label="0,1" ];
}