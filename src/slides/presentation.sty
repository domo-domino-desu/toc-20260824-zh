% \usepackage[olditem,oldenum]{paralist}
% \renewcommand*\paradescriptionlabel[1]{%
% \normalfont\bfseries\color{labelcolor} #1}
% \newenvironment{parenum}{%
%   \begin{inparaenum}[(1)]}
% {%
%   \end{inparaenum}
% }

\newenvironment{parenum}{%
 \setbeamertemplate{enumerate item}{(\arabic{enumi})}
 \let\par\relax%
 \setcounter{enumi}{1}%
 \def\item{\usebeamertemplate{enumerate  item} \stepcounter{enumi}}%
 \leavevmode%
}{%
 \setcounter{enumi}{0}%
}


